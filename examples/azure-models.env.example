# Copy values from the actual deployment Consume page. Do not put keys in this file.
# Source before importing any llm_wiki_bench modules.
export OPENAI_BASE_URL="https://YOUR-FOUNDRY-ACCOUNT.services.ai.azure.com/openai/v1"
export LLM_AUTH_MODE="azure_cli"
export LLM_AZURE_RESOURCE="https://cognitiveservices.azure.com/"
export LLM_PROVIDER="azure_foundry"
export LLM_FAST_MODEL="FW-GLM-5.2-Fast"
export LLM_PREMIUM_MODEL="FW-GLM-5.2-Fast"
export LLM_QUERY_MODEL="FW-GLM-5.2-Fast"
export LLM_LINT_MODEL="FW-GLM-5.2-Fast"
export LLM_MAX_TOKENS="16384"
export LLM_TOOL_MAX_TOKENS="8192"
export LLM_MAX_ATTEMPTS="2"
export LLM_JSON_MODE="auto"
export LLM_TOKEN_PARAMETER="max_tokens"
# Leave reasoning controls unset until the deployment supports a tested value.

# Full URL, including the route. Do not blindly append /embeddings to an AML /score URL.
export EMBEDDING_ENDPOINT="https://YOUR-EMBEDDING-ENDPOINT/REPLACE-WITH-CONSUME-ROUTE"
export EMBEDDING_PROTOCOL="openai"
# Unified Foundry: deployment name. Direct Azure ML/TEI: model ID from Consume.
export EMBEDDING_MODEL="Qwen/Qwen3-Embedding-8B"
export EMBEDDING_MODEL_VERSION="3"
export EMBEDDING_AUTH_MODE="azure_cli"
export EMBEDDING_AZURE_RESOURCE="https://cognitiveservices.azure.com/"
# For a classic AML endpoint, use its documented auth mode/audience instead.
export EMBEDDING_DIMENSIONS="4096"
export EMBEDDING_BATCH_SIZE="2"
export EMBEDDING_TIMEOUT="120"
export EMBEDDING_CHUNK_TOKENS="3000"
# A conservative UTF-8 byte cap in addition to approximate tiktoken counting.
export EMBEDDING_MAX_INPUT_BYTES="12000"
export EMBEDDING_QUERY_INSTRUCTION="Given a question, retrieve relevant wiki summaries that help answer it."
